<Window x:Class="XingqiaoDesktop.EndpointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="连接星桥网页" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Border Padding="24" Background="#F8FAFF">
    <StackPanel Width="420">
      <TextBlock Text="连接星桥网页" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Margin="0,8,0,16" TextWrapping="Wrap" Foreground="#52647D"
                 Text="输入你部署的 HTTPS 星桥网页地址。桌面端启动和刷新时都会加载该地址的最新网页。" />
      <TextBox x:Name="EndpointBox" Height="34" VerticalContentAlignment="Center" ToolTip="https://transfer.example.com" />
      <TextBlock x:Name="ErrorText" Margin="0,8,0,0" Foreground="#B42318" Visibility="Collapsed" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Content="取消" IsCancel="True" />
        <Button Content="连接" IsDefault="True" Click="Connect_Click" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
