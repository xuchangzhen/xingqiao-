<Window x:Class="XingqiaoDesktop.InboxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="星桥临时收件箱" Width="460" Height="330" MinWidth="360" MinHeight="250"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False">
  <DockPanel Margin="18">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="拖动文件到 ChatGPT、Codex 或任意支持文件投放的应用" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Margin="0,5,0,14" Foreground="#63708A" FontSize="12" TextWrapping="Wrap"
                 Text="点击行选中；按 Ctrl 或 Shift 可多选。仅“保存选中项”会永久保留，退出星桥会清理其余文件。" />
      <DockPanel Margin="0,0,0,8">
        <TextBlock x:Name="SelectionText" Foreground="#63708A" FontSize="12" VerticalAlignment="Center" Text="未选中文件" />
        <Button x:Name="SelectAllButton" DockPanel.Dock="Right" Content="全选" Click="SelectAll_Click" IsEnabled="False" />
      </DockPanel>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="PreviewButton" Content="预览" Click="Preview_Click" IsEnabled="False" />
      <Button x:Name="RemoveButton" Content="移除选中项" Click="Remove_Click" IsEnabled="False" />
      <Button x:Name="SaveButton" Content="保存选中项到…" Click="Save_Click" IsEnabled="False" />
    </StackPanel>
    <Grid>
      <ListBox x:Name="FilesList" ItemsSource="{Binding Files}" SelectionChanged="FilesList_SelectionChanged"
               PreviewMouseLeftButtonDown="FilesList_PreviewMouseLeftButtonDown"
               PreviewMouseMove="FilesList_PreviewMouseMove" MouseDoubleClick="FilesList_MouseDoubleClick"
               SelectionMode="Extended" BorderBrush="#D8E0EF" BorderThickness="1">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="8,7">
              <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
              <TextBlock Text="拖出即可使用 · 双击预览 · 尚未永久保存" Foreground="#63708A" FontSize="11" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyText" Text="暂时没有临时文件" Foreground="#77859A" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
    </Grid>
  </DockPanel>
</Window>
