# Your public subdomain. Create an A record pointing it to your VPS first.
DOMAIN=transfer.example.com
# Usually identical to DOMAIN; browsers use it to reach coturn.
TURN_HOST=transfer.example.com
# Replace before deploying. This creates one-hour, per-browser TURN credentials.
# Do not commit the resulting .env file.
TURN_SECRET=replace-with-a-long-random-secret
